<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\KiriScope.Core\KiriScope.Core.csproj" />
    <ProjectReference Include="..\KiriScope.Filters.BuiltIn\KiriScope.Filters.BuiltIn.csproj" />
    <ProjectReference Include="..\KiriScope.IO\KiriScope.IO.csproj" />
    <ProjectReference Include="..\KiriScope.Knowledge\KiriScope.Knowledge.csproj" />
    <ProjectReference Include="..\KiriScope.Resources\KiriScope.Resources.csproj" />
    <ProjectReference Include="..\KiriScope.Runtime\KiriScope.Runtime.csproj" />
    <ProjectReference Include="..\KiriScope.Xp3\KiriScope.Xp3.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- Supplied only by Build-GuiSingleFile.ps1. These self-contained workers are embedded
       in the GUI executable and are extracted only after runtime capture is explicitly enabled. -->
  <ItemGroup Condition="'$(BundledWorkerX64Path)' != '' and '$(BundledWorkerX86Path)' != ''">
    <EmbeddedResource Include="$(BundledWorkerX64Path)" LogicalName="KiriScope.Gui.RuntimeWorkers.X64" />
    <EmbeddedResource Include="$(BundledWorkerX86Path)" LogicalName="KiriScope.Gui.RuntimeWorkers.X86" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\KiriScope.RuntimeCapture.X86.dll" LogicalName="KiriScope.Gui.RuntimeCapture.X86" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\plugins\**\*"
          Exclude="..\..\plugins\templates\**\bin\**\*;..\..\plugins\templates\**\obj\**\*"
          Link="plugins\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
